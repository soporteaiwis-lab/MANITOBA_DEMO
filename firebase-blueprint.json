{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and role information",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "user"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "role", "createdAt"]
    },
    "KnowledgeChunk": {
      "title": "KnowledgeChunk",
      "description": "A chunk of text from the chat history or manual FAQ, used for RAG",
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "description": "The text content of the chunk"
        },
        "embedding": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Vector embedding of the content"
        },
        "source": {
          "type": "string",
          "description": "Source of the chunk (e.g., 'history_2023.txt', 'manual_faq')"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["content", "source", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "A conversation session between a user and the RAG chatbot",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID of the user (can be anonymous UID)"
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string", "enum": ["user", "assistant"] },
              "content": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            },
            "required": ["role", "content", "timestamp"]
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "messages", "createdAt", "updatedAt"]
    },
    "Event": {
      "title": "Event",
      "description": "Community events displayed on the website",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "date", "location", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles and roles"
    },
    "/knowledge_base/{chunkId}": {
      "schema": {
        "$ref": "#/entities/KnowledgeChunk"
      },
      "description": "Stores text chunks and embeddings for the RAG system"
    },
    "/chat_sessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/ChatSession"
      },
      "description": "Stores user chat history with the bot"
    },
    "/events/{eventId}": {
      "schema": {
        "$ref": "#/entities/Event"
      },
      "description": "Stores community events"
    }
  }
}
